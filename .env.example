# Set to the deployed, initialized AgentVault contract account on NEAR testnet.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_ESCROW_CONTRACT_ID=
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
# Supabase Auth. Use the project URL and a publishable/anon key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase PostgreSQL connection string. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=
# Optional server-side AI provider. Demo orchestration works without it.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=25000
AI_MAX_INPUT_TOKENS=6000
AI_MAX_COMPLETION_TOKENS=2000
AI_MAX_RUN_COST_USD=0.10
# Conservative blended estimate for cost guarding; set at or above your provider/model's rate.
AI_COST_PER_1K_TOKENS_USD=0.02
# Worker polling, leasing and concurrency. Lease heartbeat must remain below half the lease duration.
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_MS=120000
WORKER_HEARTBEAT_MS=20000
WORKER_MAX_ATTEMPTS=4
WORKER_MAX_PER_AGENT=1
WORKER_MAX_PER_TASK=1
